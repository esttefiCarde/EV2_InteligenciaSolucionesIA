# Copia este archivo como ".env" y completa el token (NO subas .env a GitHub)
GITHUB_TOKEN=github_pat_xxxxxxxxxxxx
# Endpoint OpenAI-compatible de GitHub Models y modelo a usar
LLM_BASE_URL=https://models.github.ai/inference
LLM_MODEL=openai/gpt-4o-mini
# Embeddings locales (multilingüe, soporta español)
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
# Parámetros del pipeline (opcionales)
K_INTERNO=4
K_EXTERNO=2
UMBRAL_RELEVANCIA=0.30
CHUNK_SIZE=800
CHUNK_OVERLAP=120
# Agente (EP2, opcionales)
# Modelo del Agente Manager (vacío = el mismo LLM_MODEL). Ej.: openai/gpt-4o (tiene menos cuota diaria)
LLM_MODEL_MANAGER=
VENTANA_MEMORIA=4
MAX_ITERACIONES=8
MAX_REPLANES=3
MAX_ITERACIONES_REACT=4
# Fecha fija del calendario para demos reproducibles (AAAA-MM-DD); vacío = fecha real
FECHA_SIMULADA=
